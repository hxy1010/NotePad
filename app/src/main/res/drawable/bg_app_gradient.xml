<?xml version="1.0" encoding="utf-8"?>
<!-- 柔和的底色渐变加上柔和的径向色斑。色斑没有硬边，
     形成毛玻璃卡片所依托的磨砂、失焦背景。 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:startColor="@color/glass_bg_start"
                android:endColor="@color/glass_bg_end" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:centerX="0.18"
                android:centerY="0.12"
                android:gradientRadius="340dp"
                android:startColor="@color/glass_blob_pink"
                android:endColor="@android:color/transparent" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:centerX="0.88"
                android:centerY="0.22"
                android:gradientRadius="300dp"
                android:startColor="@color/glass_blob_violet"
                android:endColor="@android:color/transparent" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:centerX="0.10"
                android:centerY="0.86"
                android:gradientRadius="320dp"
                android:startColor="@color/glass_blob_mint"
                android:endColor="@android:color/transparent" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:centerX="0.92"
                android:centerY="0.90"
                android:gradientRadius="300dp"
                android:startColor="@color/glass_blob_sky"
                android:endColor="@android:color/transparent" />
        </shape>
    </item>
</layer-list>
