    <color name="app_primary">#D9FFFFFF</color>
    <color name="app_primary_dark">#FFF1E8F3</color>
    <color name="app_background">#00000000</color>
    <color name="card_background">#99FFFFFF</color>
    <color name="card_stroke">#B3FFFFFF</color>
    <color name="editor_line">#33626C80</color>

    <color name="accent_soft">#80FFFFFF</color>
    <color name="accent_soft_pressed">#B3FFFFFF</color>
    <color name="accent_text">#FF6D4AE0</color>

