<?xml version="1.0" encoding="utf-8"?>
<!-- 一张磨砂玻璃卡片：从白色到透明的渐变、明亮的 1dp 描边，
     以及足够大的圆角，让粉彩背景透出来。 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="@color/glass_card_top_pressed"
                android:endColor="@color/glass_card_bottom_pressed" />
            <corners android:radius="20dp" />
            <stroke
                android:width="1dp"
                android:color="@color/glass_stroke" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="@color/glass_card_top"
                android:endColor="@color/glass_card_bottom" />
            <corners android:radius="20dp" />
            <stroke
                android:width="1dp"
                android:color="@color/glass_stroke" />
        </shape>
    </item>
</selector>
