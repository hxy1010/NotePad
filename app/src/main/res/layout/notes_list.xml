<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:background="@color/note_window_background" >

    <EditText
        android:id="@+id/search_input"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginLeft="12dp"
        android:layout_marginRight="12dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="4dp"
        android:background="@drawable/bg_glass_search"
        android:paddingLeft="18dp"
        android:paddingRight="18dp"
        android:hint="@string/search_hint"
        android:textColor="@color/note_text_primary"
        android:textColorHint="@color/note_text_time"
        android:textSize="15sp"
        android:inputType="text"
        android:imeOptions="actionSearch"
        android:singleLine="true" />

    <ListView
        android:id="@android:id/list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingTop="4dp"
        android:clipToPadding="false"
        android:cacheColorHint="@android:color/transparent"
        android:divider="@color/note_divider"
        android:dividerHeight="1dp" />

    <LinearLayout
        android:id="@android:id/empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingLeft="32dp"
        android:paddingRight="32dp" >

        <TextView
            android:id="@+id/empty_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/list_empty"
            android:textAppearance="?android:attr/textAppearanceMedium"
            android:textColor="@color/note_text_secondary" />

        <Button
            android:id="@+id/empty_new_note"
            style="@style/NotePadActionButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:paddingLeft="22dp"
            android:paddingRight="22dp"
            android:drawableLeft="@drawable/ic_cute_note_add"
            android:drawablePadding="6dp"
            android:text="@string/menu_add" />
    </LinearLayout>

    <include layout="@layout/view_bottom_nav" />

</LinearLayout>
