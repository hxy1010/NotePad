<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Night variant: dark Holo base so titles, menu items and dialogs stay legible on the
         dark glass action bar. Colours come from values-night/colors.xml. -->
    <style name="NotePadTheme" parent="@android:style/Theme.Holo">
        <item name="android:windowBackground">@drawable/bg_app_gradient</item>
        <item name="android:actionBarStyle">@style/NotePadActionBar</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@color/app_primary_dark</item>
        <item name="android:navigationBarColor">@color/app_primary_dark</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="NotePadActionBar" parent="@android:style/Widget.Holo.ActionBar.Solid">
        <item name="android:background">@color/app_primary</item>
        <item name="android:backgroundStacked">@color/app_primary</item>
        <item name="android:backgroundSplit">@color/app_primary</item>
    </style>

    <style name="NotePadDialogTheme" parent="@android:style/Theme.Holo.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>

</resources>
