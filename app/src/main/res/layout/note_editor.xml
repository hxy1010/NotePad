<?xml version="1.0" encoding="utf-8"?>
<!-- Note editor: a scrollable paper card plus photo/voice sections, with the two insert
     actions pinned to the bottom of the screen. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    android:orientation="vertical" >

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true" >

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="16dp" >

            <!-- The paper card that holds the note text -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_note_card"
                android:orientation="vertical"
                android:padding="16dp" >

                <view
                    class="com.example.android.notepad.NoteEditor$LinedEditText"
                    android:id="@+id/note"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="180dp"
                    android:background="@android:color/transparent"
                    android:hint="@string/note_hint"
                    android:padding="0dp"
                    android:scrollbars="none"
                    android:gravity="top"
                    android:textColor="@color/note_text_primary"
                    android:textColorHint="@color/note_text_time"
                    android:textSize="18sp"
                    android:capitalize="sentences" />
            </LinearLayout>

            <TextView
                android:id="@+id/section_photos"
                style="@style/NotePadSectionLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/section_photos"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/photo_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />

            <TextView
                android:id="@+id/section_audio"
                style="@style/NotePadSectionLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/section_audio"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/audio_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </LinearLayout>
    </ScrollView>

    <!-- Insert actions, pinned to the bottom of the screen -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="14dp"
        android:orientation="horizontal" >

        <Button
            android:id="@+id/btn_add_photo"
            style="@style/NotePadActionButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginRight="8dp"
            android:drawableLeft="@drawable/ic_cute_photo"
            android:drawablePadding="6dp"
            android:text="@string/action_photo" />

        <Button
            android:id="@+id/btn_record_audio"
            style="@style/NotePadActionButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:drawableLeft="@drawable/ic_cute_mic"
            android:drawablePadding="6dp"
            android:text="@string/action_voice" />
    </LinearLayout>

</LinearLayout>
