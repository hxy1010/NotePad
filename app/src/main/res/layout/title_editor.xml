<!-- Full-screen scrim with a floating glass card that edits a note title. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dialog_scrim" >

    <LinearLayout
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_dialog_glass"
        android:orientation="vertical"
        android:padding="22dp" >

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawableLeft="@drawable/ic_cute_note_add"
            android:drawablePadding="8dp"
            android:gravity="center_vertical"
            android:text="@string/title_edit_title"
            android:textColor="@color/note_text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_glass_search"
            android:gravity="center_vertical"
            android:hint="@string/dialog_title_hint"
            android:imeOptions="actionDone"
            android:inputType="text"
            android:maxLines="1"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:scrollHorizontally="true"
            android:singleLine="true"
            android:textColor="@color/note_text_primary"
            android:textColorHint="@color/note_text_time"
            android:textSize="16sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="right"
            android:orientation="horizontal" >

            <Button
                android:id="@+id/cancel"
                style="@style/NotePadActionButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="8dp"
                android:onClick="onClickCancel"
                android:paddingLeft="20dp"
                android:paddingRight="20dp"
                android:text="@string/button_cancel" />

            <Button
                android:id="@+id/ok"
                style="@style/NotePadActionButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:onClick="onClickOk"
                android:paddingLeft="24dp"
                android:paddingRight="24dp"
                android:text="@string/button_ok" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
