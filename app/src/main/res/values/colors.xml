<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Glassmorphism palette, day. The window paints a soft pastel gradient with blurry
         colour blobs; every card is translucent white so the blobs shine through. -->
    <color name="glass_bg_start">#FFF8EFF6</color>
    <color name="glass_bg_end">#FFE6F0FA</color>
    <color name="glass_blob_pink">#80FFC4D9</color>
    <color name="glass_blob_violet">#70D6C6FF</color>
    <color name="glass_blob_mint">#70B5EEDC</color>
    <color name="glass_blob_sky">#70A6D2FF</color>

    <color name="glass_card_top">#8CFFFFFF</color>
    <color name="glass_card_bottom">#59FFFFFF</color>
    <color name="glass_card_top_pressed">#CCFFFFFF</color>
    <color name="glass_card_bottom_pressed">#A6FFFFFF</color>
    <color name="glass_stroke">#B3FFFFFF</color>
    <!-- Almost opaque glass used by floating dialogs so text stays readable. -->
    <color name="dialog_surface_top">#F7FFFFFF</color>
    <color name="dialog_surface_bottom">#E6EEF5FF</color>
    <!-- Dim layer drawn behind the glass dialog card. -->
    <color name="dialog_scrim">#59000000</color>

    <color name="note_window_background">#00000000</color>
